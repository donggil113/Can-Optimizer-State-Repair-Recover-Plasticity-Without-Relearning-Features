    },
    {
      "access": {
        "boundary_oracle": true,
        "labels": "current batch"
      },
      "intervention": {
        "counter": "decoupled",
        "kind": "mix",
        "rho_m": 0.5,
        "rho_v": 0.5
      },
      "name": "mix_0.5",
      "note": "rho fixed a priori, not tuned",
      "timing": "oracle_boundary",
      "type": "branch"
    },
    {
      "access": {
        "boundary_oracle": true,
        "labels": "current batch"
      },
      "intervention": {
        "counter": "shared_keep",
        "kind": "reset_m"
      },
      "name": "reset_m__shared_keep",
      "note": "bias-correction artifact probe",
