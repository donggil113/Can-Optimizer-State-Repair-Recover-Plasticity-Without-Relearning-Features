        "labels": "current batch"
      },
      "intervention": {
        "counter": "decoupled",
        "kind": "reset_m"
      },
      "name": "reset_m",
      "timing": "oracle_boundary",
      "type": "branch"
    },
    {
      "access": {
        "boundary_oracle": true,
        "labels": "current batch"
      },
      "intervention": {
        "counter": "decoupled",
        "kind": "reset_v"
      },
